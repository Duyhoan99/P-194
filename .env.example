# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL_NAME=gpt-4o-mini
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SUMMARY_AGENT_BACKEND=deterministic
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db
SUMMARY_BACKEND=sqlite
SUMMARY_DATABASE_PATH=./data/clinical_summaries.db
SUMMARY_POSTGRES_DSN=

# ---- Clinical Retrieval Backend ----
# Local/test only; production must use PostgreSQL and a trusted auth provider.
CLINICAL_BACKEND=sqlite
CLINICAL_DATABASE_PATH=./data/mimic_demo.db
CLINICAL_POSTGRES_DSN=
CLINICAL_POOL_SIZE=5
CLINICAL_SOURCE_DATASET=MIMIC-IV
CLINICAL_SOURCE_VERSION=3.1
CLINICAL_SOURCE_PROFILE=mimic-iv-3.1
# Shared cursor/demo-session signing secret. Use a random secret of at least 32 characters outside local development.
CLINICAL_CURSOR_SECRET=local-development-only-change-me
CLINICAL_CURSOR_TTL_SECONDS=900
MIMIC_DEMO_SOURCE_DIR=./mimic-iv-clinical-database-demo-2.2
MIMIC_DEMO_SUBJECTS_FILE=./mimic-iv-clinical-database-demo-2.2/demo_subject_id.csv
MIMIC_DEMO_SUBJECT_LIMIT=3

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-local-ai-log-key
AI_LOG_DIR=.ai-log

# ---- Next.js doctor interface ----
# Public origin only; the demo session remains in an HTTP-only cookie.
NEXT_PUBLIC_API_URL=http://localhost:8000
