# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=
AGENT_GENERATION_BACKEND=deterministic
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Demo data and session ----
DEMO_DATA_DIR=./data/demo_mvp_v1
# Local uses SQLite/JSON fallback. Render must receive the Supabase PostgreSQL URL.
DATABASE_URL=sqlite:///./data/app.db
# Use a random value of at least 32 characters outside local development.
SESSION_SECRET=local-development-only-change-me
SESSION_TTL_SECONDS=900
# Public URL reachable from the patient's phone (HTTPS domain in deployment).
CARE_PLAN_PUBLIC_BASE_URL=http://localhost:8000
# Signed listening links remain valid for 90 days; a newer plan revokes the old link.
CARE_PLAN_SHARE_TTL_SECONDS=7776000

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-local-ai-log-key
AI_LOG_DIR=.ai-log

# ---- Next.js doctor interface ----
# Server-side Next proxy target. Browser requests stay same-origin by default.
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional only when the browser must call a separate API origin:
# NEXT_PUBLIC_API_URL=http://localhost:8000
